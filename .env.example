# Chép file này thành ".env" (cùng thư mục) rồi điền sau dấu =
# Lấy key miễn phí ở https://www.eulerstream.com (đăng ký, vào mục API Keys)
EULER_API_KEY=

# Chỉ điền khi báo lỗi DEVICE_BLOCKED. Dùng NICK PHỤ, không dùng nick chính.
# Lấy từ trình duyệt đã đăng nhập tiktok.com: F12 > Application > Cookies > https://www.tiktok.com
# sessionid -> TIKTOK_SESSION_ID, tt-target-idc -> TIKTOK_TT_TARGET_IDC
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=
